#!/usr/bin/env bash
# Checks the AUR carries the versions a release tag just published: flea and flea-bin
# report X.Y.Z-1 and flea-git reports X.Y.Z.r0.g<first 7 hex of the tag's commit>-1.
# One line per package on stdout, exit 1 on any mismatch, exit 2 on usage errors.
# Reads the live RPC unless --json FILE gives a saved reply, which is what the suite uses.
set -uo pipefail

json_file=""
if [ "${1:-}" = "--json" ]; then
    [ -n "${2:-}" ] || { echo "flea-aur-versions: --json needs a file" >&2; exit 2; }
    json_file=$2
    shift 2
fi
[ "$#" -eq 2 ] || { echo "usage: flea-aur-versions [--json FILE] X.Y.Z COMMIT" >&2; exit 2; }
version=$1
commit=$2
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "flea-aur-versions: '$version' is not X.Y.Z" >&2; exit 2; }
[[ "$commit" =~ ^[0-9a-f]{7} ]] || { echo "flea-aur-versions: commit must open with at least 7 hex digits" >&2; exit 2; }
short=${commit:0:7}

if [ -n "$json_file" ]; then
    [ -f "$json_file" ] || { echo "flea-aur-versions: no file at '$json_file'" >&2; exit 2; }
    reply=$(cat -- "$json_file")
else
    # Same bounds src/update.rs uses: ten seconds and one mebibyte.
    reply=$(curl -q --silent --fail --globoff --max-time 10 --max-filesize 1M \
        'https://aur.archlinux.org/rpc/v5/info?arg[]=flea&arg[]=flea-bin&arg[]=flea-git') \
        || { echo "flea-aur-versions: the AUR RPC could not be read" >&2; exit 1; }
fi

# Name and version per result, tab separated; a reply that will not parse is a mismatch, not a crash.
listed=$(printf '%s' "$reply" | python3 -c '
import json, sys
try:
    doc = json.load(sys.stdin)
    rows = doc.get("results", [])
    for r in rows:
        print("%s\t%s" % (r.get("Name", ""), r.get("Version", "")))
except Exception as e:
    sys.stderr.write("flea-aur-versions: the RPC reply did not parse: %s\n" % e)
    sys.exit(1)
') || exit 1

failed=0
check() {
    local name=$1 want=$2 got
    got=$(printf '%s\n' "$listed" | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')
    if [ "$got" = "$want" ]; then
        printf '%s: ok %s\n' "$name" "$got"
    elif [ -z "$got" ]; then
        printf '%s: MISMATCH missing from the AUR reply, want %s\n' "$name" "$want"
        failed=1
    else
        printf '%s: MISMATCH got %s, want %s\n' "$name" "$got" "$want"
        failed=1
    fi
}
check flea "$version-1"
check flea-bin "$version-1"
check flea-git "$version.r0.g$short-1"
exit "$failed"

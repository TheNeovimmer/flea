# One field out of one stored PKGBUILD, shared by the pre-tag guard and the AUR check. Sourced, never run.
# Fails closed: any unreadable commit, file or value answers non-zero with no output, so callers name it.

# Sample input: pkgrel=2 or pkgrel='1' # note
field() {
  local body line value
  body=$(git show "$1:$2" 2>/dev/null) || return 1
  line=$(printf '%s\n' "$body" | grep -m1 "^$3=") || return 1
  value=${line#*=}
  value=${value%%#*}
  value=$(printf '%s' "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e "s/^['\"]//" -e "s/['\"]$//")
  [ -n "$value" ] || return 1
  printf '%s' "$value"
}
